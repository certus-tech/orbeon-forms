<!DOCTYPE xbl [
<!ENTITY self "cta-prepopulation-field">
<!-- value to set when an annotation on the instance data is 'on' -->
<!ENTITY set "1">
<!-- Orbeon uses this to separate components in IDs. \u2261 IDENTICAL TO. -->
<!ENTITY compsep "&#8801;">
]>
<!--
 A pre-population field for all types of fields. This pulls data from a source form/field and populates a read-only
 input field.
-->
<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:fb="http://orbeon.org/oxf/xml/form-builder"
         xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
         xmlns:oxf="http://www.orbeon.com/oxf/processors"
         xmlns:ev="http://www.w3.org/2001/xml-events"
         xmlns:xi="http://www.w3.org/2001/XInclude"
         xmlns:cta="http://www.certus-tech.com/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl">

  <xbl:binding
    id="&self;"
    element="cta|prepopulation-field"
    xxbl:mode="lhha binding value focus external-value"
    xxf:external-events="cta-set-formprepopulation"
    >

    <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
      <display-name lang="en">Pre-population Field</display-name>
      <icon>
        <icon-class>fa fa-fw fa-history</icon-class>
      </icon>
      <templates>
        <view>
          <cta:prepopulation-field prefix="" suffix="" field-width="">
            <xf:label  ref=""/>
            <xf:hint   ref=""/>
            <xf:help   ref=""/>
            <xf:alert  ref=""/>
          </cta:prepopulation-field>
        </view>
      </templates>
      <control-details>
        <xf:model xmlns="" id="fb-&self;-model">
          <xf:action event="xforms-model-construct-done" iterate="instance('local')/*">
            <xf:var name="c" value="."/>
            <xf:setvalue ref="$c" value="instance()/@*[name() = name($c)]"/>
          </xf:action>
          <xf:instance id="local" xxf:exclude-result-prefixes="#all">
            <local>
              <field-width/>
            </local>
          </xf:instance>
        </xf:model>
        <fr:grid xmlns="" id="fb-editor-&self;-grid">
          <xh:tr>
            <xh:td colspan="6">
              <xf:select1 ref="instance('local')/field-width" appearance="full xxf:horizontal" id="field-width-control">
                <xf:label ref="xxf:r('xbl-control-settings.field-width', '|fr-form-resources|')"/>
                <xf:item>
                  <xf:label ref="xxf:r('xbl-control-settings.default', '|fr-form-resources|')"/>
                  <xf:value/>
                </xf:item>
                <xf:item>
                  <xf:label ref="xxf:r('xbl-control-settings.full', '|fr-form-resources|')"/>
                  <xf:value>full</xf:value>
                </xf:item>
                <xf:item>
                  <xf:label ref="xxf:r('xbl-control-settings.natural', '|fr-form-resources|')"/>
                  <xf:value>natural</xf:value>
                </xf:item>
              </xf:select1>
            </xh:td>
          </xh:tr>
        </fr:grid>
        <!-- Update the control attribute corresponding to the observed fields below, on change. -->
        <xf:action
          id="fb-editor-&self;-action"
          event="xforms-value-changed"
          observer="field-width-control">
          <xf:var name="name" value="name(event('xxf:binding'))"/>
          <xf:var name="new-value" value="string(event('xxf:binding'))"/>
          <xf:insert context="instance()" if="xxf:non-blank($new-value)" origin="xf:attribute($name, $new-value)"/>
          <xf:delete if="xxf:is-blank($new-value)" ref="instance()/@*[name() = $name]"/>
        </xf:action>
      </control-details>
    </metadata>

    <xbl:template>
      <xf:var name="field-width" value="fr:component-param-value('field-width')"/>
      <xf:group id="&self;-group">
        <xf:model id="&self;-model">
          <xf:var name="model-path" value="string-join(xxf:binding('&self;')/ancestor-or-self::*[not(local-name() = 'form')]/local-name(), '/')"/>
          <xf:var name="prepopulation-value-path" value="concat('xxf:instance(&#34;cta-form-prepopulation-instance&#34;)/form[last()]/', $model-path)"/>
          <!-- The prepopulation date is expected to be on the field as an attribute @date.-->
          <xf:var name="model-date-path" value="concat(string-join(xxf:binding('&self;')/ancestor-or-self::*[not(local-name() = 'form')]/local-name(), '/'), '/@date')"/>
          <xf:var name="prepopulation-date-path" value="concat('xxf:instance(&#34;cta-form-prepopulation-instance&#34;)/form[last()]/', $model-date-path)"/>

          <xf:var name="history-date" value="xxf:evaluate($prepopulation-date-path)"/>
          <xf:var name="history-value" value="xxf:evaluate($prepopulation-value-path)"/>
          <xf:var name="history-set" value="exists($history-date) and $history-value != ''"/>
          <xf:var name="binding" value="xxf:binding('cta-prepopulation-field')"/>
          <xf:var name="view" value="xxf:is-control-readonly('cta-prepopulation-field')"/>

          <!-- Create placeholder from Orbeon Forms input format
          https://doc.orbeon.com/configuration/properties/xforms#for-xf-input -->
          <xf:var name="placeholder" value="
                      let $format      := xxf:property('oxf.xforms.format.input.date'),
                          $cleaned     := translate($format, '[01]', ''),
                          $duplicate   := replace(replace(replace($cleaned,
                                          'M', 'MM'),
                                          'D', 'DD'),
                                          'Y', 'YYYY'),
                          $format-en   := instance('orbeon-resources')/resource[@xml:lang = 'en']/format,
                          $format-lang := xxf:r('format'),
                          $translated  := translate($duplicate, $format-en, $format-lang)
                      return
                          $translated
                  "/>
          <xf:instance id="cta-enhanced-control-mode">
            <control>
              <current-value/>
            </control>
          </xf:instance>
          <xf:instance id="cta-form-resources" xxf:readonly="true">
            <resources>
              <resource xml:lang="en">
                <history-not-collected>Not previously collected</history-not-collected>
                <history-collected-on>As collected on </history-collected-on>
              </resource>
            </resources>
          </xf:instance>
          <xf:instance id="orbeon-resources" xxf:readonly="true">
            <resources>
              <resource xml:lang="en"><format>MDY</format></resource>
              <resource xml:lang="fr"><format>MJA</format></resource>
               <resource xml:lang="de"><format>MTJ</format></resource>
             </resources>
           </xf:instance>

        </xf:model>
        <xh:div class="cta-prepopulation-control__wrapper cta-prepopulation-control__wrapper--inline">
          <!-- Read-only value. -->
          <xh:span class="cta-prepopulation-control__history-wrapper">
            <xh:span class="cta-prepopulation-control__history-label">
              <xh:div class="input-append fr-field-width-{$field-width}">
                <xf:input type="text"
                placeholder="{$placeholder}"
                ref="$history-value"
                class="cta-enhanced-control__ro-input"
                readonly="true()"/>
              </xh:div>
            <xf:output if="$history-set" value="if ($history-set) then xxf:r('history-collected-on', 'cta-form-resources') else xxf:r('history-not-collected', 'cta-form-resources')"/>
            <xf:output if="$history-set" ref="if ($history-set) then format-dateTime(xs:dateTime($history-date), '[D,2]/[M,2]/[Y]') else ''"/>
            </xh:span>
          </xh:span>
        </xh:div>
      </xf:group>
    </xbl:template>
  </xbl:binding>
</xbl:xbl>
