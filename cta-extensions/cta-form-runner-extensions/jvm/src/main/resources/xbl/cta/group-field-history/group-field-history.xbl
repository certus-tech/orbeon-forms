<!DOCTYPE xbl [ 
<!ENTITY self "cta-group-field-history" > 
<!-- names for the internal field states/modes -->
<!ENTITY not-collected "1">
<!ENTITY unchanged "2">
<!-- value to set when an annotation on the instance data is 'on' -->
<!ENTITY set "1">
]>
<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
         xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
         xmlns:oxf="http://www.orbeon.com/oxf/processors"
         xmlns:ev="http://www.w3.org/2001/xml-events"
         xmlns:xi="http://www.w3.org/2001/XInclude"
         xmlns:ctao="http://www.certus-tech.com/orbeon"
         xmlns:cta="http://www.certus-tech.com/xbl">

  <!-- @xxbl:mode binding means orbeon will pass in an actual binding, with the @id below, allowing this control to bind to the form's model. -->
  <xbl:binding id="&self;" element="cta|group-field-history" xxbl:mode="binding custom-lhha value selection">
    <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
      <display-name lang="en">'No changes' toggle</display-name>
      <icon lang="en">
        <small-icon>/apps/fr/style/images/silk/time.png</small-icon>
        <large-icon>/apps/fr/style/images/silk/time.png</large-icon>
      </icon>

      <templates>
        <view>
          <cta:group-field-history history-entry="last()"/>
        </view>
      </templates>
      <control-details>
        <xf:model xmlns="" id="fb-&self;-model">
          <xf:action event="xforms-model-construct-done" iterate="instance('local')/*">
            <xf:var name="c" value="."/>
            <xf:setvalue ref="$c" value="instance()/@*[name() = name($c)]"/>
          </xf:action>

          <xf:instance id="local" xxf:exclude-result-prefixes="#all">
            <local>
              <history-entry/>
            </local>
          </xf:instance>

          <xf:instance id="fr-form-resources" xxf:readonly="true">
            <resources>
              <resource xml:lang="en">
                <history-entry>History entry</history-entry>
                <history-entry-hint>Which values from the history to use, based on history XML order. An XPath predicate to match one form from the history.</history-entry-hint>
                <history-entry-first>First</history-entry-first>
                <history-entry-last>Last</history-entry-last>
              </resource>
            </resources>
          </xf:instance>
        </xf:model>
        <fr:grid id="fb-editor-&self;-grid">
          <xh:tr>
            <xh:td>
              <fr:open-select1 xxf-type="xs:integer" ref="instance('local')/history-entry" appearance="minimal" id="history-entry-control">
                <xf:label ref="xxf:r('history-entry')"/>
                <xf:hint ref="xxf:r('history-entry-hint')"/>
                <xf:item>
                  <xf:label ref="xxf:r('history-entry-first')"/>
                  <xf:value>1</xf:value>
                </xf:item>
                <xf:item>
                  <xf:label ref="xxf:r('history-entry-last')"/>
                  <xf:value>last()</xf:value>
                </xf:item>
              </fr:open-select1>
            </xh:td>
          </xh:tr>
        </fr:grid>
        <!-- Update the control attribute corresponding to the observed fields below, on change. -->
        <xf:action
          id="fb-editor-&self;-action"
          event="xforms-value-changed"
          observer="history-entry-control history-mode-control">
          <xf:var name="name" value="name(event('xxf:binding'))"/>
          <xf:var name="new-value" value="string(event('xxf:binding'))"/>
          <xf:insert context="instance()" if="xxf:non-blank($new-value)" origin="xf:attribute($name, $new-value)"/>
          <xf:delete if="xxf:is-blank($new-value)" ref="instance()/@*[name() = $name]"/>
        </xf:action>
      </control-details>
    </metadata>

    <xbl:resources/>
    <xbl:handlers/>

    <xbl:template xxbl:transform="oxf:xslt">
          <xsl:transform version="2.0">
            <xsl:template match="/*">
              <xf:group id="&self;-group">

                <xf:model id="cta-history-internal">
                  <!-- This instance must exist else xxf:instance appears to fail to find the (external) history. -->
                  <xf:instance id="internal">
                    <data>
                      <toggle>false</toggle>
                    </data>
                  </xf:instance>


                  <xf:bind id="&self;-toggle-bind" ref="xxf:instance('internal')/toggle" type="xf:boolean"/>

                  <xf:action event="xforms-value-changed"
                             observer="&self;-toggle"
                             fr:keep-if-design-time="false"
                             iterate="xxf:instance('fr-form-instance')//xxf:evaluate(xxf:binding('&self;')/../name())/*">

                    <!-- Variables used in the iterations of each field in the section -->
                    <xf:var name="name" value="name()"/>
                    <xf:var name="entry" value="fr:component-param-value('history-entry')"/>
                    <xf:var name="ancestors" value="xxf:instance('fr-form-instance')//*[name()=$name]/ancestor-or-self::*[not(local-name() = 'form')]"/>
                    <!-- history fields will return a node whether or not data is included -->
                    <xf:var name="history_path" value="concat('xxf:instance(&quot;cta-form-history-instance&quot;)/form[', $entry, ']/', string-join( $ancestors/local-name(), '/'))"/>
                    <xf:var name="binding_node" value="xxf:instance('fr-form-instance')//*[name()=$name]"/>

                    <!-- Take all CHANGED history fields and set to unchanged -->
                    <!-- passes the tempnotchanged attribute to assist this process  -->
                    <xf:insert if="boolean(xxf:evaluate($history_path)) and not(boolean($binding_node/@notchanged))"
                                context="$binding_node" origin="xxf:attribute('tempnotchanged', &set;)"/>
                    <xf:delete if="boolean(xxf:evaluate($history_path)) and not(boolean($binding_node/@notchanged))"
                                ref="$binding_node/@notchanged"/>

                    <!-- Note not($binding_node/text()) is required to access data via date select / single select button which is not type in like input/number -->
                    <xf:setvalue if="(boolean(xxf:evaluate($history_path))) and (boolean($binding_node/@tempnotchanged)) and (boolean($binding_node/text()='') or not($binding_node/text()) )" ref="$binding_node" value="&set;"/>
                    <xf:setvalue if="(boolean(xxf:evaluate($history_path))) and (boolean($binding_node/@tempnotchanged)) and (boolean($binding_node/text()!=''))" ref="$binding_node" value="''"/>

                    <!-- Take all NOT COLLECTED history fields and set to unchanged -->
                    <!-- passes the tempnotcollected attribute to assist this process  -->
                    <!-- separate method required to inject data to invoke the  <xf:action ev:event="xforms-value-changed" ev:observer="html-input"> -->
                    <xf:insert if="( (boolean(xxf:evaluate($history_path))) and (boolean($binding_node/@notcollected)) )"
                            context="$binding_node" origin="xxf:attribute('tempnotcollected', &set;)"/>
                    <xf:delete if="( (boolean(xxf:evaluate($history_path))) and (boolean($binding_node/@notcollected)) )"
                                ref="$binding_node/@notcollected"/>
                    <xf:setvalue  if="( (boolean(xxf:evaluate($history_path))) and (boolean($binding_node/@tempnotcollected)) )"
                                  ref="$binding_node" value="&set;"/>

                    <!-- Resetting the input box to unchecked if process wants to be run again -->
                    <xf:setvalue ref="xxf:instance('internal')/toggle" value="false"/>
                  </xf:action>

                </xf:model>

                <xh:div>
                  <fr:checkbox-input id="&self;-toggle" bind="&self;-toggle-bind">
                    <xf:label>There are No changes</xf:label>
                    <xf:hint>(Click button to set all history fields to Unchanged)</xf:hint>
                  </fr:checkbox-input>
                </xh:div>
              </xf:group>
            </xsl:template>
          </xsl:transform>
    </xbl:template>
  </xbl:binding>
</xbl:xbl>
