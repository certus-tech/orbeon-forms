<!DOCTYPE xbl [
<!ENTITY self "cta-enhanced-text">
<!-- names for the internal field states/modes -->
<!ENTITY not-collected "1">
<!ENTITY unchanged "2">
<!ENTITY changed "3">
<!-- value to set when an annotation on the instance data is 'on' -->
<!ENTITY set "1">
<!-- Orbeon uses this to separate components in IDs. \u2261 IDENTICAL TO. -->
<!ENTITY compsep "&#8801;">
]>
<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
         xmlns:fb="http://orbeon.org/oxf/xml/form-builder"
         xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
         xmlns:oxf="http://www.orbeon.com/oxf/processors"
         xmlns:ev="http://www.w3.org/2001/xml-events"
         xmlns:xi="http://www.w3.org/2001/XInclude"
         xmlns:cta="http://www.certus-tech.com/xbl"
         xmlns:exsl="http://exslt.org/common">
  <xbl:binding
    id="&self;"
    element="cta|enhanced-text"
    xxbl:mode="lhha binding value focus"
    xxf:external-events="fr-set-client-value cta-click-to-edit"
    xxbl:label-for="html-input">

    <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
      <display-name lang="en">Enhanced text</display-name>
      <icon>
        <icon-class>fa fa-fw fa-i-cursor</icon-class>
      </icon>
      <templates>
        <view>
          <cta:enhanced-text history-entry="last()" history-mode="available-modes-all">
            <xf:label ref=""/>
            <xf:hint ref=""/>
            <xf:help ref=""/>
            <xf:alert ref=""/>
          </cta:enhanced-text>
        </view>
      </templates>
      <!-- As of 2018-12-03 the upstream source does not allow XInclude here so this is all duped.
     See comment in this location on currency.xbl for detail.
    <xi:include
      xmlns:fb="http://orbeon.org/oxf/xml/form-builder"
      href="/xbl/orbeon/number/number.xbl"
      xpointer="xpath(/xbl:xbl/xbl:binding/fb:metadata/fb:control-details)"/>-->
      <control-details>
        <xf:model xmlns="" id="fb-&self;-model">
          <xf:action event="xforms-model-construct-done" iterate="instance('local')/*">
            <xf:var name="c" value="."/>
            <xf:setvalue ref="$c" value="instance()/@*[name() = name($c)]"/>
          </xf:action>

          <xf:instance id="local" xxf:exclude-result-prefixes="#all">
            <local>
              <history-entry>last()</history-entry>
              <history-mode>available-modes-all</history-mode>
            </local>
          </xf:instance>

          <xf:instance id="fr-form-resources" xxf:readonly="true">
            <resources>
              <resource xml:lang="en">
                <history-entry>History entry</history-entry>
                <history-entry-hint>Which value from the history to display, based on history XML order. An XPath predicate to match one form from the history.</history-entry-hint>
                <history-entry-first>First</history-entry-first>
                <history-entry-last>Last</history-entry-last>
                <history-mode>History mode</history-mode>
                <history-mode-hint>Which history controls to be available</history-mode-hint>
                <history-mode-all>All</history-mode-all>
                <history-mode-not-unchanged>Not unchanged</history-mode-not-unchanged>
              </resource>
            </resources>
          </xf:instance>
        </xf:model>

        <fr:grid xmlns="" id="fb-editor-&self;-grid">
          <xh:tr>
            <xh:td colspan="6">
              <fr:open-select1 xxf-type="xs:integer" ref="instance('local')/history-entry" appearance="minimal" id="history-entry-control">
                <xf:label ref="xxf:r('history-entry')"/>
                <xf:hint ref="xxf:r('history-entry-hint')"/>
                <xf:item>
                  <xf:label ref="xxf:r('history-entry-first')"/>
                  <xf:value>1</xf:value>
                </xf:item>
                <xf:item>
                  <xf:label ref="xxf:r('history-entry-last')"/>
                  <xf:value>last()</xf:value>
                </xf:item>
              </fr:open-select1>
            </xh:td>
          </xh:tr>
          <xh:tr>
            <xh:td colspan="6">
              <xf:select1 xxf-type="xs:string" ref="instance('local')/history-mode" appearance="minimal" id="history-mode-control">
                <xf:label ref="xxf:r('history-mode')"/>
                <xf:hint ref="xxf:r('history-mode-hint')"/>
                <xf:item>
                  <xf:label ref="xxf:r('history-mode-all')"/>
                  <xf:value>available-modes-all</xf:value>
                </xf:item>
                <xf:item>
                  <xf:label ref="xxf:r('history-mode-not-unchanged')"/>
                  <xf:value>available-modes-not-unchanged</xf:value>
                </xf:item>
              </xf:select1>
            </xh:td>
          </xh:tr>

        </fr:grid>
        <!-- Update the control attribute corresponding to the observed fields below, on change. -->
        <xf:action
          id="fb-editor-&self;-action"
          event="xforms-value-changed"
          observer="history-entry-control history-mode-control">
          <xf:var name="name" value="name(event('xxf:binding'))"/>
          <xf:var name="new-value" value="string(event('xxf:binding'))"/>
          <xf:insert context="instance()" if="xxf:non-blank($new-value)" origin="xf:attribute($name, $new-value)"/>
          <xf:delete if="xxf:is-blank($new-value)" ref="instance()/@*[name() = $name]"/>
        </xf:action>
      </control-details>
    </metadata>

    <xbl:resources/>

    <xbl:handlers>
      <!-- Respond to the custom cta-click-to-edit event sent from JS. -->
      <xbl:handler event="cta-click-to-edit" phase="target">
        <xf:setfocus event="DOMActivate" control="html-input"/>
      </xbl:handler>
    </xbl:handlers>

    <xbl:template xxbl:transform="oxf:xslt">
      <xsl:transform version="2.0">
        <xsl:template match="/*">
          <xf:group id="&self;-group">
            <xf:model id="&self;-model">
              <!-- TODO Potentially common model -->
              <xf:var name="element-name"
                      value="xxf:binding('&self;')/name()"/>
              <xf:var name="history-entry"
                      value="fr:component-param-value('history-entry')"/>
              <xf:var name="history-mode"
                      value="fr:component-param-value('history-mode')"/>
              <!--
               TODO: This is partially working support for single level repeats. It has various issues.
               - Adding new repeats will put the history subscript e.g. [4] off the end of the available history.
               - This (I think) leads to weird effects where changing status of one control influences a sibling.
               - It allows controls to be in unusual states e.g. add a new repeat then set to 'unchanged'.
               - It is unclear whether *-iteration elements need to be ignored in the history path (always? only
                 in sections? only in grids?).
               - Does not cater to customised iteration names at all.
              -->
              <!--<xf:var name="repeat-position-raw" value="xxf:repeat-position()"/>-->
              <!--<xf:var name="repeat-position" value="if (string(exsl:object-type($repeat-position-raw)) = 'number') then $repeat-position-raw else 1"/>-->
              <!--Any matching elem can be used to build a path for all N repeats (if any), hence [1] subscript below.-->
              <!--<xf:var name="model-elem" value="(xxf:instance('fr-form-instance')//*[name()=$element-name])[1]"/>-->
              <!--<xf:var name="model-path-parts" value="$model-elem/ancestor::*[not(local-name() = 'form')][not(contains(local-name(), '-iteration'))]"/>-->
              <!--<xf:var name="model-path" value="concat(string-join($model-path-parts/local-name(), '/'), '[', $repeat-position, ']/', $element-name)"/>-->
              <xf:var name="model-path"
                      value="string-join(xxf:instance('fr-form-instance')//*[name()=$element-name]/ancestor-or-self::*[not(local-name() = 'form')]/local-name(), '/')"/>
              <xf:var name="history-value-path"
                      value="concat('xxf:instance(&#34;cta-form-history-instance&#34;)/form[', $history-entry, ']/', $model-path)"/>
              <xf:var name="history-date-path"
                      value="concat('xxf:instance(&#34;cta-form-history-instance&#34;)/form[', $history-entry, ']/', $model-path,'/@date')"/>
              <!-- Items won't be used/makes no sense for non-select controls. N.b. xxf:itemset does not appear to work here. -->
              <!-- TODO using resource[1] is a hack which can not support multi-lingual forms. -->
              <xf:var name="items"
                      value="xxf:instance('fr-form-resources')/resource[1]/*[name()=$element-name]/item"/>

              <xf:instance id="cta-enhanced-control-mode">
                <control>
                  <current-mode/>
                  <current-value/>
                  <available-modes-all>
                    <mode>
                      <label>Changed</label>
                      <value>&changed;</value>
                    </mode>
                    <mode>
                      <label>Unchanged</label>
                      <value>&unchanged;</value>
                    </mode>
                    <mode>
                      <label>Not collected</label>
                      <value>&not-collected;</value>
                    </mode>
                  </available-modes-all>
                  <available-modes-not-unchanged>
                    <mode>
                      <label>Changed</label>
                      <value>&changed;</value>
                    </mode>
                    <mode>
                      <label>Not collected</label>
                      <value>&not-collected;</value>
                    </mode>
                  </available-modes-not-unchanged>
                </control>
              </xf:instance>
              <xf:instance id="cta-form-resources" xxf:readonly="true">
                <resources>
                  <resource xml:lang="en">
                    <history-not-collected>Not previously collected</history-not-collected>
                    <history-collected-on>As collected on </history-collected-on>
                  </resource>
                </resources>
              </xf:instance>

              <!-- Binds cannot ref cta-form-history-instance: These only seem to bind to the default data. -->
              <xf:bind id="&self;-control-mode-bind" name="&self;-current-mode"
                       ref="instance('cta-enhanced-control-mode')/current-mode"/>

              <xf:bind id="ro-binding" ref="instance('cta-enhanced-control-mode')/current-value" readonly="true()"/>

             <xf:action ev:event="xforms-value-changed" ev:observer="html-input">
                <!-- Keep the internal 'current value' in sync with the real value (even if the RO control is shown). -->
                <xf:setvalue ref="instance('cta-enhanced-control-mode')/current-value" value="event('xxf:value')"/>

                <!-- Easy way to access status of history meta -->
                <xf:var name="mode" value="instance('cta-enhanced-control-mode')/current-mode"/>

                <!-- If value entered into a history field, change meta from not collected (or unchanged) to changed -->
                <xf:setvalue bind="&self;-control-mode-bind" value="&changed;"
                            if="(xxf:binding('&self;')/text() != '' ) and
                                not(xxf:binding('&self;')/@tempchanged) and
                                not(xxf:binding('&self;')/@tempnotcollected)"/>


                <!-- set metadata to unchanged if the custom tempchanged attribute is passed in
                     from the cta:group-field-history field -->
                <xf:setvalue bind="&self;-control-mode-bind" value="&unchanged;"
                             if="(xxf:binding('&self;')/@tempchanged=&set;)"/>

                <!-- set metadata to unchanged if the custom tempnotcollected attribute is passed in
                     from the cta:group-field-history field -->
                <xf:setvalue bind="&self;-control-mode-bind" value="&unchanged;"
                             if="(xxf:binding('&self;')/@tempnotcollected=&set;)"/>

                <!-- Change to Not collected if there is no data in the current value and meta is NOT Unchanged  -->
                <!-- So that both Not collected and changed will point to Not Collected -->
                <xf:setvalue bind="&self;-control-mode-bind" value="&not-collected;"
                             if="( (not(xxf:binding('&self;')/text())) or
                                   (xxf:binding('&self;')/text() = '')
                                 ) and
                                 ($mode = (&changed;, &not-collected;))"/>
              </xf:action>

              <xf:action ev:event="xforms-value-changed" ev:observer="&self;-mode-control"
                         fr:keep-if-design-time="false">
                <xf:variable name="mode" value="xs:int(event('xxf:value'))"/>

                <!-- Clear the field value IF we are selecting NotCollected or Unchanged -->
                <xf:setvalue ref="xxf:binding('&self;')" value="()" if="$mode = (&not-collected;, &unchanged;)"/>
                <!-- Remove existing annotations. -->
                <xf:delete ref="xxf:binding('&self;')/@changed"/>
                <xf:delete ref="xxf:binding('&self;')/@notcollected"/>
                <xf:delete ref="xxf:binding('&self;')/@notchanged"/>
                <xf:delete ref="xxf:binding('&self;')/@tempnotcollected"/>
                <xf:delete ref="xxf:binding('&self;')/@tempchanged"/>

                <!-- Add annotations for notcollected/unchanged if appropriate. -->
                <xf:insert context="xxf:binding('&self;')" origin="xxf:attribute('changed', &set;)" if="$mode = &changed;"/>
                <xf:insert context="xxf:binding('&self;')" origin="xxf:attribute('notcollected', &set;)" if="$mode = &not-collected;"/>
                <xf:insert context="xxf:binding('&self;')" origin="xxf:attribute('notchanged', &set;)" if="$mode = &unchanged;"/>
                <!-- Toggle the UI case RO/RW. -->
                <xf:toggle case="read-only" if="$mode = (&not-collected;, &unchanged;)" />
                <xf:toggle case="writable"  if="$mode = &changed;" />
              </xf:action>

              <!-- Initialise the internal model and bootstrap the form model if needed. -->
              <xf:action ev:event="xforms-model-construct-done" ev:observer="&self;-model" fr:keep-if-design-time="false">
                <!-- Copy in the current value, if any. -->
                <xf:setvalue ref="instance('cta-enhanced-control-mode')/current-value" value="xxf:binding('&self;')"/>

                <!-- Set the internal mode to match the state of the data. -->
                <xf:setvalue bind="&self;-control-mode-bind"
                             value="if (xs:int(xxf:binding('&self;')/@changed) = &set;) then &changed;
                                    else if (xs:int(xxf:binding('&self;')/@notcollected) = &set;) then &not-collected;
                                    else if (xs:int(xxf:binding('&self;')/@notchanged) = &set;) then &unchanged;
                                    else if (empty(xxf:binding('&self;')/*) and string-length(normalize-space(xxf:binding('&self;')/text())) = 0) then &not-collected;
                                    else &changed;"/>

                <!-- If the binding node is empty and does not have any attrs, initialise it with not collected. -->
                <xf:insert context="xxf:binding('&self;')"
                           origin="xxf:attribute('notcollected', &set;)"
                           if="empty(
                               (xxf:binding('&self;')/@notcollected,
                               xxf:binding('&self;')/@notchanged,
                               xxf:binding('&self;')/@changed)
                               )
                               and (empty(xxf:binding('&self;')/*) and string-length(normalize-space(xxf:binding('&self;')/text())) = 0)"/>
              </xf:action>

              <!-- Run some custom code when the model is built, with which a click listener is hooked up onto the
              container for the read-only field. This fires an event back to the component side. -->
              <xf:action type="javascript" ev:event="xforms-model-construct-done">
                <xf:param name="clientId" value="xxf:client-id('&self;')"/>
                <xf:param name="compsep" value="'&compsep;'"/>
                <xf:body>
                  ORBEON.jQuery(`#${clientId}${compsep}ro-input`).on('click', function() {
                  ORBEON.xforms.Document.dispatchEvent(clientId, "cta-click-to-edit");
                  });
                </xf:body>
              </xf:action>

            </xf:model>

            <xh:div class="cta-enhanced-control__wrapper cta-enhanced-control__wrapper--inline">
              <xh:span class="cta-enhanced-control__mode-wrapper">
                <xf:select1 id="&self;-mode-control" bind="&self;-control-mode-bind">
                  <xf:itemset ref="instance('cta-enhanced-control-mode')/xxf:evaluate($history-mode)/mode">
                    <xf:label ref="label"/>
                    <xf:value ref="value"/>
                  </xf:itemset>
                </xf:select1>
              </xh:span>

              <xh:span class="input cta-enhanced-control__input-wraper">
                <xf:switch id="&self;-view-switch">
                  <xf:case id="writable">
                    <xf:input id="html-input" ref="xxf:binding('&self;')"/>
                  </xf:case>
                  <xf:case id="read-only">
                    <xf:input id="ro-input" bind="ro-binding" class="cta-enhanced-control__ro-input"/>
                  </xf:case>
                </xf:switch>
              </xh:span>

              <xh:span class="cta-enhanced-control__history-wrapper">
                <xf:var name="history-date" value="xxf:evaluate($history-date-path)"/>
                <xf:var name="history-value" value="xxf:evaluate($history-value-path)"/>
                <xf:var name="history-set" value="exists($history-date)"/>
                <xh:span class="cta-enhanced-control__history-label">
                  <xf:output if="$history-set" value="if ($history-set) then xxf:r('history-collected-on', 'cta-form-resources') else xxf:r('history-not-collected', 'cta-form-resources')"/>
                  <xf:output ref="format-dateTime(xs:dateTime(xxf:evaluate($history-date-path)), '[D,2]/[M,2]/[Y]: ')"/>
                  <xf:output value="if ($history-set) then $history-value else ''"/>
                 </xh:span>
              </xh:span>
            </xh:div>
          </xf:group>
        </xsl:template>

      </xsl:transform>
    </xbl:template>

  </xbl:binding>
</xbl:xbl>
