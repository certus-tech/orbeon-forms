<!DOCTYPE xbl [ 
<!ENTITY self "cta-group-field-history" > 
<!-- names for the internal field states/modes -->
<!ENTITY not-collected "1">
<!ENTITY unchanged "2">
<!-- value to set when an annotation on the instance data is 'on' -->
<!ENTITY set "1">
<!ENTITY history-common "/xbl/cta/history-field-common/history-field-common.xml" > 
]>
<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
         xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
         xmlns:oxf="http://www.orbeon.com/oxf/processors"
         xmlns:ev="http://www.w3.org/2001/xml-events"
         xmlns:xi="http://www.w3.org/2001/XInclude"
         xmlns:ctao="http://www.certus-tech.com/orbeon"
         xmlns:cta="http://www.certus-tech.com/xbl">

  <!-- @xxbl:mode binding means orbeon will pass in an actual binding, with the @id below, allowing this control to bind to the form's model. -->
  <xbl:binding id="&self;" element="cta|group-field-history" xxbl:mode="binding custom-lhha">
    <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
      <display-name lang="en">'No changes' toggle</display-name>
      <icon lang="en">
        <small-icon>/apps/fr/style/images/silk/time.png</small-icon>
        <large-icon>/apps/fr/style/images/silk/time.png</large-icon>
      </icon>

      <templates>
        <view>
          <cta:group-field-history history-entry="last()"/>
        </view>
      </templates>
      <control-details>
        <xf:model xmlns="" id="fb-&self;-model">
          <xf:action event="xforms-model-construct-done" iterate="instance('local')/*">
            <xf:var name="c" value="."/>
            <xf:setvalue ref="$c" value="instance()/@*[name() = name($c)]"/>
          </xf:action>

          <xf:instance id="local" xxf:exclude-result-prefixes="#all">
            <local>
              <history-entry/>
            </local>
          </xf:instance>

          <xf:bind ref="instance('local')">
            <xf:bind ref="history-entry" xxf:whitespace="trim"/>
          </xf:bind>

          <xf:instance id="fr-form-resources" xxf:readonly="true">
            <resources>
              <resource xml:lang="en">
                <history-entry>History entry</history-entry>
                <history-entry-hint>Which values from the history to use, based on history XML order. An XPath predicate to match one form from the history.</history-entry-hint>
                <history-entry-first>First</history-entry-first>
                <history-entry-last>Last</history-entry-last>
              </resource>
            </resources>
          </xf:instance>
        </xf:model>
        <fr:grid id="fb-editor-&self;-grid">
          <xh:tr>
            <xh:td>
              <fr:open-select1 xxf-type="xs:integer" ref="instance('local')/history-entry" appearance="minimal" id="history-entry-control">
                <xf:label ref="xxf:r('history-entry')"/>
                <xf:hint ref="xxf:r('history-entry-hint')"/>
                <xf:item>
                  <xf:label ref="xxf:r('history-entry-first')"/>
                  <xf:value>1</xf:value>
                </xf:item>
                <xf:item>
                  <xf:label ref="xxf:r('history-entry-last')"/>
                  <xf:value>last()</xf:value>
                </xf:item>
              </fr:open-select1>
            </xh:td>
          </xh:tr>
        </fr:grid>
        <xf:action
          id="fb-editor-&self;-action"
          event="xforms-value-changed"
          observer="history-entry-control">
          <xf:var name="name"      value="name(event('xxf:binding'))"/>
          <xf:var name="new-value" value="string(event('xxf:binding'))"/>
          <xf:insert
            context="instance()"
            if="xxf:non-blank($new-value)"
            origin="xf:attribute($name, $new-value)"/>
          <xf:delete
            if="xxf:is-blank($new-value)"
            ref="instance()/@*[name() = $name]"/>
        </xf:action>
      </control-details>
    </metadata>
    
    <xi:include href="&history-common;" xpointer="xpath(/xbl:xbl/xbl:binding/xbl:resources, /xbl:xbl/xbl:binding/xbl:handlers)"/>
    
    <xbl:template xxbl:transform="oxf:xslt">
      <xsl:transform version="2.0">
        <xsl:template match="/*">
          <xf:group id="&self;-group">
            
            <xf:model id="cta-history-internal">
              <!-- This instance must exist else xxf:instance appears to fail to find the (external) history. -->
              <xf:instance id="internal">
                <data>
                  <toggle>false</toggle>
                </data>
              </xf:instance>
              
              <xf:bind id="&self;-toggle-bind" ref="xxf:instance('internal')/toggle" type="xf:boolean"/>
              
              <xf:action event="xforms-value-changed" 
                         observer="&self;-toggle" 
                         fr:keep-if-design-time="false"
                         iterate="xxf:instance('fr-form-instance')//xxf:evaluate(xxf:binding('&self;')/../name())/*">
                <xf:var name="name" value="name()"/>
                <xf:var name="mode" value="if (string(event('xxf:binding')) = 'true') then &unchanged; else &not-collected;"/>
                <xf:var name="entry" value="fr:component-param-value('history-entry')"/>
                <xf:var name="ancestors" value="xxf:instance('fr-form-instance')//*[name()=$name]/ancestor-or-self::*[not(local-name() = 'form')]"/>
                <xf:var name="history_path" value="concat('xxf:instance(&quot;cta-form-history-instance&quot;)/form[', $entry, ']/', string-join( $ancestors/local-name(), '/'))"/>                
                <xf:var name="binding_node" value="xxf:instance('fr-form-instance')//*[name()=$name]"/>                
                <xf:var name="act" value="$history_path and $binding_node"/>                
                <!-- NOTE 2021-07-19: 
                This could togglee between unchanged/not-collected but then it is impossible to remove the attrs if they
                are applied to non-history-aware fields, which they probably are; they probably then end up out of sync
                and hence wrong. Instead only @notchanged is managed. Values are cleared when unchecking but @notcollected
                is not applied.
                -->
                <!-- Delete any meta attrs. -->
                <xf:delete ref="$binding_node/@notcollected"/>
                <xf:delete ref="$binding_node/@notchanged"/>
                <!-- If this field is ticked (entering unchanged mode), copy the value and set unchanged. -->
                <xf:setvalue if="$act and ($mode = &unchanged;)" ref="$binding_node" value="xxf:evaluate($history_path)"/>
                <xf:insert   if="$act and ($mode = &unchanged;)" context="$binding_node" origin="xxf:attribute('notchanged', &set;)"/>
                <!-- If this field is unticked (entering not collected mode), clear the value and set not collected. -->
                <xf:setvalue if="$act and ($mode = &not-collected;)" ref="$binding_node" value="()"/>
                <!-- Do not put @notcollected on as it's impossible to remove it from non-history-aware fields. -->
                <!--<xf:insert   if="$act and ($mode = &not-collected;)" context="$binding_node" origin="xxf:attribute('notchanged', &set;)"/>-->
              </xf:action>
              
            </xf:model>
            
            <xh:div>
              <fr:checkbox-input id="&self;-toggle" bind="&self;-toggle-bind">
                <xf:label>No changes (previous values stand)</xf:label>
                <xf:hint/>
              </fr:checkbox-input>
            </xh:div>
          </xf:group>
        </xsl:template>
      </xsl:transform>
    </xbl:template>
  </xbl:binding>
</xbl:xbl>
