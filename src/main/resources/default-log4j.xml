<Configuration status="WARN">

    <!-- This is the standard log appender to the console (System.err) -->
    <Appenders>
        <Console name="ConsoleAppender" target="SYSTEM_ERR">
            <PatternLayout pattern="%d{ISO8601} %-5p %c %x - %m%n"/>
            <ThresholdFilter level="INFO"/>
        </Console>
    </Appenders>

    <!-- This is the root logger -->
    <Loggers>
        <Root level="info">
            <AppenderRef ref="ConsoleAppender"/>
        </Root>
    </Loggers>

</Configuration>
