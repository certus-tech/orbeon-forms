<!DOCTYPE xbl [ 
<!ENTITY self "cta-enhanced-state-selector">
<!-- names for the internal field states/modes -->
<!ENTITY not-collected "1">
<!ENTITY unchanged "2">
<!ENTITY collected "3">
<!-- value to set when an annotation on the instance data is 'on' -->
<!ENTITY set "1">
<!-- Orbeon uses this to separate components in IDs. \u2261 IDENTICAL TO. -->
<!ENTITY compsep "&#8801;">
]>
<xbl:xbl xmlns:xh="http://www.w3.org/1999/xhtml"
         xmlns:xf="http://www.w3.org/2002/xforms"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xxf="http://orbeon.org/oxf/xml/xforms"
         xmlns:xbl="http://www.w3.org/ns/xbl"
         xmlns:xxbl="http://orbeon.org/oxf/xml/xbl"
         xmlns:fr="http://orbeon.org/oxf/xml/form-runner"
         xmlns:fb="http://orbeon.org/oxf/xml/form-builder"
         xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
         xmlns:oxf="http://www.orbeon.com/oxf/processors"
         xmlns:ev="http://www.w3.org/2001/xml-events"
         xmlns:xi="http://www.w3.org/2001/XInclude"
         xmlns:cta="http://www.certus-tech.com/xbl"
         xmlns:NumberSupport="java:org.orbeon.xbl.NumberSupportJava">
  <xbl:binding
    id="&self;"
    element="cta|enhanced-state-selector"
    xxbl:mode="binding value focus"
    xxf:external-events="fr-set-client-value cta-click-to-edit"
    xxbl:label-for="html-input">

    <metadata xmlns="http://orbeon.org/oxf/xml/form-builder">
      <display-name lang="en">Enhanced state selector</display-name>
      <icon>
        <icon-class>fa fa-fw fa-history</icon-class>
      </icon>
      <templates>
        <view>
          <cta:enhanced-state-selector history-entry="last()" history-mode="available-modes-all"
                               prefix="" suffix="" digits-after-decimal="" decimal-separator="" grouping-separator="">
          </cta:enhanced-state-selector>
        </view>
      </templates>

      <control-details>
        <xf:model xmlns="" id="fb-editor-state-selector-model">

          <xf:action event="xforms-model-construct-done" iterate="instance('local')/*">
              <xf:var name="c" value="."/>
              <xf:setvalue ref="$c" value="instance()/@*[name() = name($c)]"/>
          </xf:action>

          <xf:instance id="local" xxf:exclude-result-prefixes="#all">
              <local>
                  <test/>
              </local>
          </xf:instance>

          <xf:instance id="fr-form-resources" xxf:readonly="true">
              <resources>
                  <resource xml:lang="en">
                      <test>Test</test>
                  </resource>
              </resources>
          </xf:instance>
      </xf:model>
      <fr:grid xmlns="" id="fb-editor-state-selector-grid">
          <xh:tr>
              <xh:td colspan="2">
                  <xf:input ref="instance('local')/test" id="test-control">
                      <xf:label ref="xxf:r('test')"/>
                      <xf:alert/>
                  </xf:input>
              </xh:td>
          </xh:tr>
      </fr:grid>
      <xf:action
          id="fb-editor-number-action"
          event="xforms-value-changed"
          observer="
              test-control">

          <xf:var name="name"      value="name(event('xxf:binding'))"/>
          <xf:var name="new-value" value="string(event('xxf:binding'))"/>
          <xf:insert
              context="instance()"
              if="xxf:non-blank($new-value)"
              origin="xf:attribute($name, $new-value)"/>
          <xf:delete
              if="xxf:is-blank($new-value)"
              ref="instance()/@*[name() = $name]"/>
        </xf:action>
        </control-details>
    </metadata>
    <xbl:resources/>

    <xbl:template xxbl:transform="oxf:xslt">
      <xsl:transform version="2.0">
        <xsl:template match="/*">
          <xf:group id="&self;-group">
            <xf:model id="&self;-model">
              <!-- TODO Potentially common model -->              
              <xf:var name="element-name" value="xxf:binding('&self;')/name()"/>
              <xf:var name="history-entry" value="fr:component-param-value('history-entry')"/>
              <xf:var name="history-mode" value="fr:component-param-value('history-mode')"/>
              <xf:var name="model-path"
                      value="string-join(xxf:instance('fr-form-instance')//*[name()=$element-name]/ancestor-or-self::*[not(local-name() = 'form')]/local-name(), '/')"/>
              <xf:var name="history-value-path"
                      value="concat('xxf:instance(&#34;cta-form-history-instance&#34;)/form[', $history-entry, ']/', $model-path)"/>
              <xf:var name="history-date-path"
                      value="concat('xxf:instance(&#34;cta-form-history-instance&#34;)/form[', $history-entry, ']/@date')"/>
              <!-- Items won't be used/makes no sense for non-select controls. N.b. xxf:itemset does not appear to work here. -->
              <!-- TODO using resource[1] is a hack which can not support multi-lingual forms. -->
              <xf:var name="items"
                      value="xxf:instance('fr-form-resources')/resource[1]/*[name()=$element-name]/item"/>
              
              <xf:instance id="cta-enhanced-control-mode">
                <control>
                  <current-mode/>
                  <current-value/>
                  <available-modes-all>
                    <mode>
                      <label>Not collected</label>
                      <value>&not-collected;</value>
                    </mode>
                    <mode>
                      <label>Unchanged</label>
                      <value>&unchanged;</value>
                    </mode>
                    <mode>
                      <label>Collected</label>
                      <value>&collected;</value>
                    </mode>
                  </available-modes-all>
                  <available-modes-not-unchanged>
                    <mode>
                      <label>Not collected</label>
                      <value>&not-collected;</value>
                    </mode>
                    <mode>
                      <label>Collected</label>
                      <value>&collected;</value>
                    </mode>
                  </available-modes-not-unchanged>
                </control>
              </xf:instance>

              <!-- Binds cannot ref cta-form-history-instance: These only seem to bind to the default data. -->
              <xf:bind id="&self;-control-mode-bind" name="&self;-current-mode"
                       ref="instance('cta-enhanced-control-mode')/current-mode"/>

              <xf:bind id="ro-binding" ref="instance('cta-enhanced-control-mode')/current-value" readonly="true()"/>
              
              <!-- Keep the internal 'current value' in sync with the real value (even if the RO control is shown). -->
              <xf:action ev:event="xforms-value-changed" ev:observer="html-input" fr:keep-if-design-time="false">
                <xf:setvalue ref="instance('cta-enhanced-control-mode')/current-value" value="event('xxf:value')"/>
              </xf:action>
            </xf:model>
            
            <xh:div class="cta-enhanced-control__wrapper cta-enhanced-control__wrapper--inline">
              <xh:span class="cta-enhanced-control__mode-wrapper">
                <xf:select1 id="&self;-mode-control" bind="&self;-control-mode-bind">
                  <xf:itemset ref="instance('cta-enhanced-control-mode')/available-modes-all/mode">
                    <xf:label ref="label"/>
                    <xf:value ref="value"/>
                  </xf:itemset>
                </xf:select1>
              </xh:span>
            </xh:div>
          </xf:group>
        </xsl:template>
      </xsl:transform>
    </xbl:template>
  </xbl:binding>
</xbl:xbl>
